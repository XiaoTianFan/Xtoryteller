{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xtoryteller.dev/schema/presentation.json",
  "type": "object",
  "required": ["meta", "mode"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "slug"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "thumbnail": { "type": "string" }
      },
      "additionalProperties": true
    },
    "mode": { "enum": ["stage", "map"] },
    "theme": { "type": "string", "minLength": 1 },
    "themeOverrides": { "type": "object" },
    "data": { "type": "object" },
    "background": { "$ref": "#/$defs/background" },
    "backgroundSections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["match", "shader"],
        "properties": {
          "match": { "type": "object", "additionalProperties": true },
          "shader": { "$ref": "#/$defs/background" }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/cluster" }
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" },
        "spacing": { "type": "number" },
        "minZoom": { "type": "number" },
        "maxZoom": { "type": "number" },
        "initialZoom": { "type": "number" },
        "arrangement": { "$ref": "#/$defs/clusterArrangement" }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "properties": {
        "sequence": { "type": "array", "items": { "type": "string" } },
        "transition": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "stage" } } },
      "then": { "required": ["steps"] }
    },
    {
      "if": { "properties": { "mode": { "const": "map" } } },
      "then": { "required": ["clusters"] }
    }
  ],
  "$defs": {
    "background": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "type": { "enum": ["paper-shader", "css", "none", "paper"] },
            "presetRef": { "type": "string" },
            "shader": { "type": "string" },
            "preset": { "type": "string" },
            "params": { "type": "object" },
            "value": { "type": "string" },
            "gradient": {
              "type": "object",
              "properties": {
                "type": { "enum": ["linear", "radial"] },
                "angle": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "number" }
                  ]
                },
                "position": { "type": "string" },
                "stops": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 2
                }
              },
              "required": ["stops"],
              "additionalProperties": false
            },
            "variant": { "type": "string" },
            "colorStops": { "type": "array", "items": { "type": "string" } },
            "intensity": { "type": "number" },
            "grain": { "type": "number" },
            "contrast": { "type": "number" },
            "speed": { "type": "number" },
            "opacity": { "type": "number" },
            "filter": { "$ref": "#/$defs/backgroundFilter" },
            "transition": {
              "type": "object",
              "properties": {
                "duration": { "type": "number" },
                "easing": { "type": "string" }
              },
              "additionalProperties": true
            },
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["steps"],
                "properties": {
                  "steps": {
                    "type": "array",
                    "prefixItems": [{ "type": "integer" }, { "type": "integer" }],
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "type": { "enum": ["paper-shader", "css", "none", "paper"] },
                  "presetRef": { "type": "string" },
                  "shader": { "type": "string" },
                  "preset": { "type": "string" },
                  "params": { "type": "object" },
                  "value": { "type": "string" },
                  "gradient": {
                    "type": "object",
                    "properties": {
                      "type": { "enum": ["linear", "radial"] },
                      "angle": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "number" }
                        ]
                      },
                      "position": { "type": "string" },
                      "stops": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 2
                      }
                    },
                    "required": ["stops"],
                    "additionalProperties": false
                  },
                  "variant": { "type": "string" },
                  "colorStops": { "type": "array", "items": { "type": "string" } },
                  "intensity": { "type": "number" },
                  "grain": { "type": "number" },
                  "contrast": { "type": "number" },
                  "speed": { "type": "number" },
                  "opacity": { "type": "number" },
                  "filter": { "$ref": "#/$defs/backgroundFilter" }
                },
                "additionalProperties": true
              }
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "clusters": { "type": "array", "items": { "type": "string" } },
                  "group": { "type": "string" },
                  "type": { "enum": ["paper-shader", "css", "none", "paper"] },
                  "presetRef": { "type": "string" },
                  "shader": { "type": "string" },
                  "preset": { "type": "string" },
                  "params": { "type": "object" },
                  "value": { "type": "string" },
                  "gradient": {
                    "type": "object",
                    "properties": {
                      "type": { "enum": ["linear", "radial"] },
                      "angle": {
                        "oneOf": [
                          { "type": "string" },
                          { "type": "number" }
                        ]
                      },
                      "position": { "type": "string" },
                      "stops": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 2
                      }
                    },
                    "required": ["stops"],
                    "additionalProperties": false
                  },
                  "variant": { "type": "string" },
                  "colorStops": { "type": "array", "items": { "type": "string" } },
                  "intensity": { "type": "number" },
                  "grain": { "type": "number" },
                  "contrast": { "type": "number" },
                  "speed": { "type": "number" },
                  "opacity": { "type": "number" },
                  "filter": { "$ref": "#/$defs/backgroundFilter" }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "backgroundFilter": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "radial",
            "radial-reverse",
            "linear-horizontal",
            "linear-horizontal-reverse",
            "linear-vertical",
            "linear-vertical-reverse"
          ]
        },
        "opacity": { "type": "number" },
        "radialSize": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" }
          },
          "additionalProperties": false
        },
        "linearProportion": { "type": "number" },
        "steepness": { "type": "number" }
      },
      "required": ["mode"],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "slot": { "type": "string" },
        "content": { "type": "string" },
        "props": { "type": "object" },
        "style": { "type": "object" },
        "build": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "with": { "type": "integer", "minimum": 0 }
              },
              "required": ["with"],
              "additionalProperties": false
            }
          ]
        },
        "enter": { "type": "string" },
        "exit": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "position": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["layout", "components"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "layout": { "type": "string" },
        "layoutProps": { "type": "object" },
        "transition": { "type": "string" },
        "background": { "$ref": "#/$defs/background" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        }
      },
      "additionalProperties": false
    },
    "clusterFrame": {
      "type": "object",
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "clusterAnchor": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "relativeTo": { "type": "string" },
        "direction": {
          "enum": [
            "left",
            "right",
            "above",
            "below",
            "upper-right",
            "upper-left",
            "lower-right",
            "lower-left"
          ]
        },
        "distance": { "type": "number" }
      },
      "additionalProperties": false
    },
    "clusterArrangement": {
      "type": "object",
      "properties": {
        "algorithm": { "enum": ["flow", "radial", "grid", "tree"] },
        "columns": { "type": "number", "exclusiveMinimum": 0 },
        "radius": { "type": "number", "exclusiveMinimum": 0 },
        "spacing": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "cluster": {
      "type": "object",
      "required": ["id", "layout", "components"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "group": { "type": "string" },
        "labelPosition": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right"] },
        "layout": { "type": "string" },
        "frame": { "$ref": "#/$defs/clusterFrame" },
        "layoutProps": { "type": "object" },
        "transition": { "type": "string" },
        "background": { "$ref": "#/$defs/background" },
        "anchor": { "$ref": "#/$defs/clusterAnchor" },
        "arrangement": { "$ref": "#/$defs/clusterArrangement" },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/component" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
