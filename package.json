{
  "name": "xtoryteller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"next dev\" \"node scripts/watch.mjs\"",
    "build": "npm run validate:all && next build",
    "export": "cross-env STATIC_EXPORT=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "validate": "node scripts/validate.mjs",
    "validate:theme": "node scripts/validate-theme.mjs",
    "validate:all": "node scripts/run-with-tracked-file-guard.mjs validate:all node scripts/validate-all.mjs",
    "registries": "node scripts/generate-registries.mjs",
    "presentation:export": "node scripts/export.mjs",
    "presentation:import": "node scripts/import.mjs",
    "component:promote": "node scripts/promote-component.mjs",
    "watch": "node scripts/watch.mjs",
    "test": "vitest run tests/contracts tests/unit tests/integration && npm run test:portability && npm run test:e2e",
    "test:contracts": "vitest run tests/contracts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:portability": "node scripts/run-with-tracked-file-guard.mjs test:portability node scripts/test-portability.mjs",
    "test:e2e": "npm run build && node scripts/run-with-tracked-file-guard.mjs test:e2e node node_modules/playwright/cli.js test",
    "test:qa": "vitest run tests/contracts tests/unit tests/integration && npm run test:portability && npm run test:e2e"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.72",
    "@use-gesture/react": "^10.3.1",
    "@xstate/react": "^5.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.10.0",
    "fast-glob": "^3.3.3",
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.7.0",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0",
    "xstate": "^5.18.2",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "chokidar": "^4.0.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  }
}
